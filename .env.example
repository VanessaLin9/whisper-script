# Whisper.cpp Configuration
# Update this path to match your Whisper.cpp installation
WHISPER_ROOT=/Users/YourName/whisper.cpp

# Output directories
MEETING_RECORDS_DIR=$HOME/MeetingRecords
TRANSCRIPTS_DIR=$HOME/MeetingRecords/Transcripts

# Audio device (macOS AVFoundation format)
# Use :0 for built-in Mac microphone
# Run 'ffmpeg -f avfoundation -list_devices true -i ""' to see available devices
MIC_DEVICE=:0

# Recording capture format. The raw file is kept before Whisper normalization.
RECORDING_SAMPLE_RATE=48000
RECORDING_CHANNELS=1

# Model preferences (optional - scripts will auto-detect)
DEFAULT_LANGUAGE="zh"
PREFERRED_MODEL="small"   # (tiny/base/small/medium/large)

# Performance settings (optional)
# THREADS=8

# Optional short whisper.cpp initial prompt for ASR vocabulary/context.
# Keep this short; do not put transcript-cleaning instructions here.
# WHISPER_PROMPT="Inno Group AI Team; Chronos; Athena; GitLab; ..."

# Optional: read-only Notion integration token for prompt-note sync.
# Prefer macOS Keychain or an environment injection in production.
# NOTION_TOKEN=

# Recording source: mic (default), system, both. A terminal session asks before
# starting; noninteractive use takes this explicit setting. Never auto-detected.
RECORDING_SOURCE=mic
# Native both mode uses the default macOS microphone unless an exact unique ID
# is set here. This is separate from FFmpeg's numeric MIC_DEVICE.
# List IDs: .local/recorder/meeting-recorder --list-microphones
# RECORDING_MIC_DEVICE_ID=
# Relative mix weights, each > 0 and <= 10; original tracks remain untouched.
RECORDING_SYSTEM_GAIN=1
RECORDING_MIC_GAIN=1
